{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix frontend-next ci",
  "buildCommand": "npm --prefix frontend-next run build",
  "outputDirectory": "frontend-next/out",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{code/**,dataset/**}",
      "excludeFiles": "{frontend/**,frontend-next/**,code/tests/**,code/tools/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/:path*/", "destination": "/:path*/index.html" }
  ]
}
